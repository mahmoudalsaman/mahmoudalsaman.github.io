---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isVisible } from '../../lib/content';
import { SITE } from '../../consts';

// Generate one static page per visible post. `isVisible` (src/lib/content) is
// the single source of truth for the workflow: published-only in production,
// everything in dev for authoring/review preview.
export const getStaticPaths = (async () => {
  const posts = await getCollection('posts', isVisible);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

const canonical = new URL(`/posts/${post.id}/`, Astro.site ?? Astro.url).href;

// Article structured data so posts are eligible for rich results.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate
    ? { dateModified: post.data.updatedDate.toISOString() }
    : {}),
  url: canonical,
  mainEntityOfPage: canonical,
  keywords: post.data.tags,
  author: { '@type': 'Organization', name: SITE.author },
  publisher: { '@type': 'Organization', name: SITE.author },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  jsonLd={jsonLd}
>
  {
    post.data.status !== 'published' && (
      <p class="preview-banner">
        Preview — status: <strong>{post.data.status}</strong>. Only visible on
        the dev server; it will not ship until published.
      </p>
    )
  }
  <article>
    <Content />
  </article>
</BaseLayout>

<style>
  .preview-banner {
    margin: 0 0 1.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px dashed currentColor;
    border-radius: 4px;
    font-size: 0.875rem;
    opacity: 0.8;
  }
</style>
