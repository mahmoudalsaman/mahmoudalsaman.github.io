---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isVisible, byNewest } from '../lib/content';

// List visible posts (published in prod; everything in dev), newest first.
const posts = (await getCollection('posts', isVisible)).sort(byNewest);
---

<BaseLayout
  title="qriib"
  description="A lean, niche-agnostic content platform."
>
  <h1>qriib</h1>
  <p>A lean, niche-agnostic content platform.</p>

  <ul>
    {
      posts.map((post) => (
        <li>
          <a href={`/posts/${post.id}/`}>{post.data.title}</a>
          {post.data.status !== 'published' && (
            <span class="status-tag"> [{post.data.status}]</span>
          )}
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .status-tag {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.6;
  }
</style>
