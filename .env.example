# --- AI content pipeline (scripts/pipeline.mjs) ---
# Required for real draft generation. PAID — model spend; flag usage to the CEO.
# Without it, the pipeline only runs in --dry-run mode (zero spend).
# ANTHROPIC_API_KEY=sk-ant-...

# Analytics configuration (all optional). Copy to `.env` to enable.
# With nothing set, the site ships with zero tracking and zero spend.
#
# Provider: cloudflare | goatcounter | plausible | umami | none (default: none)
PUBLIC_ANALYTICS_PROVIDER=none

# Cloudflare Web Analytics (FREE, cookieless, hosted dashboard). Recommended.
# Create a site in the Cloudflare dashboard -> Web Analytics, copy the token.
# PUBLIC_CF_BEACON_TOKEN=

# GoatCounter (FREE, privacy-friendly, hosted dashboard). Zero-config fallback.
# Sign up at goatcounter.com, then use https://<your-code>.goatcounter.com/count
# PUBLIC_GOATCOUNTER_ENDPOINT=

# Plausible (PAID SaaS ~$9/mo, or self-host for free). Flag spend to the CEO.
# PUBLIC_PLAUSIBLE_DOMAIN=qriib.com

# Umami (FREE, self-hosted/open-source).
# PUBLIC_UMAMI_SRC=https://your-umami-host/script.js
# PUBLIC_UMAMI_WEBSITE_ID=
